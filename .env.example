# Copy to .env and adjust:  cp .env.example .env
BASE_URL=https://dmoneyportal.roadtocareer.net
API_URL=https://dmoney.roadtocareer.net

ADMIN_EMAIL=admin@dmoney.com
ADMIN_PASSWORD=1234
SYSTEM_EMAIL=system@dmoney.com
SYSTEM_PASSWORD=1234

# Password the Agent is registered with, and the one it is reset to
AGENT_PASSWORD=1234
AGENT_NEW_PASSWORD=Newpass@123

# Header the portal frontend itself sends on admin API calls (used only for test data setup)
API_SECRET_KEY=ROADTOSDET

# Optional: reuse an existing ACTIVE customer instead of creating a fresh one.
# (Customers have a balance cap, so a fresh customer is more reliable.)
# CUSTOMER_PHONE=01XXXXXXXXX

# Optional: slow every action by N ms (handy when recording the headed demo)
# SLOW_MO=300
