{
  "name": "dmoney-playwright",
  "version": "1.0.0",
  "description": "Playwright E2E automation for the DMoney portal (Agent journey)",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "regression": "cross-env REPORT_DIR=playwright-report-regression playwright test",
    "regression:headed": "cross-env REPORT_DIR=playwright-report-regression playwright test --headed",
    "smoke": "cross-env REPORT_DIR=playwright-report-smoke playwright test --grep @smoke",
    "smoke:headed": "cross-env REPORT_DIR=playwright-report-smoke playwright test --grep @smoke --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.6",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.9",
    "typescript": "^7.0.2"
  }
}
